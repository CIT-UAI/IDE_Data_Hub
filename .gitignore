# Git Ignore para IDE Data Hub — Centro de Inteligencia Territorial (CIT-UAI)

# 1. Scripts operacionales del sistema y ejecutables batch (SEGURIDAD Y CONTROL)
*.bat
*.cmd
*.ps1

# 2. Scripts de infraestructura interna, despliegue cloud y telemetría privada (SEGURIDAD)
sincronizar_y_publicar_online.py
desplegador_ide_produccion.py
desplegar_colector_telemetria.py
configurar_apigw_telemetria.py
update_lambda.py
activar_subdominio_uai.py
verificar_produccion_online.py
verify_fixes.py
conversacion_con_agente.py
auditar_y_reentrenar_agente.py
analizar_consultas_y_aprendizaje.py
test_chips_and_suggestions.py
test_copilot_preguntas.py
actualizar_catalogo_coberturas_nuevas.py
actualizar_catalogo_pem.py
actualizar_metadatos_archivos_catalogo.py
auditar_index.py
verificador_servicios_tiles.py

# 3. Archivos compilados de distribución y cachés
dist/
build/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# 4. Entornos virtuales y dependencias
.venv/
venv/
env/
ENV/
node_modules/

# 5. Datos masivos descargables (> 100 MB límite estricto de GitHub)
# Los datos espaciales masivos se distribuyen vía AWS S3 / CloudFront (https://ide.cit.uai.cl/download/)
download/*.parquet
download/*.gpkg
download/*.csv
download/*.zip
download/*.shp
download/*.dbf
download/*.shx
download/*.tar.gz
*.parquet
*.gpkg

# Excepciones de descarga: conservar scripts de verificación y conectores livianos en download/
!download/reproducir_verificacion_r15.py
!download/SHA256SUMS.txt
!download/qgis/
!download/iso_xml/

# 6. Carpetas y scripts de depuración local temporal
scratch/
scratch_*.py
test_runs/
test_masivo/
repositorio_mbht2024_metodologia/
*.log

# 7. Secretos y credenciales de entorno (Invariante 27)
.env
.env.*
!.env.example
credentials.json
*.pem
*.key
*.id_rsa

# 8. Archivos del sistema operativo y editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
